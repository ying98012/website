---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import TopNav from "@/components/TopNav.astro";
import { getLocalizedProjects, t, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = await getLocalizedProjects(locale);
---

<BaseLayout
  title={t(locale, "projectsMetaTitle")}
  description={t(locale, "projectsMetaDescription")}
  locale={locale}
  alternatePath="projects"
  disableMainWrapper={true}
>
  <div class="flex min-h-screen flex-col pt-20">
    <TopNav active="projects" locale={locale} />

    <main class="mx-auto w-full max-w-container-max flex-grow px-margin-mobile pb-section-gap pt-32 md:px-margin-desktop">
      <header class="mb-stack-lg border-b border-outline-variant/10 pb-stack-sm">
        <h1 class="font-headline-md text-headline-md text-on-surface">{t(locale, "projectsPageTitle")}</h1>
        <p class="mt-2 font-body-md text-body-md text-on-surface-variant">
          {t(locale, "projectsPageDescription")}
        </p>
      </header>

      {
        projects.length > 0 ? (
          <div class="grid grid-cols-1 gap-gutter md:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => (
              <ProjectCard project={project} locale={locale} />
            ))}
          </div>
        ) : (
          <p class="font-body-md text-body-md text-on-surface-variant">{t(locale, "projectsEmpty")}</p>
        )
      }
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
