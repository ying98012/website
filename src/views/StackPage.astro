---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import TopNav from "@/components/TopNav.astro";
import { getLocalizedPage, t, type Locale } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const stackPage = await getLocalizedPage("stack-page", locale);
---

<BaseLayout
  title={t(locale, "stackMetaTitle")}
  description={t(locale, "stackMetaDescription")}
  locale={locale}
  alternatePath="stack"
  disableMainWrapper={true}
>
  <div class="min-h-screen pt-20">
    <TopNav active="stack" locale={locale} />

    <main class="mx-auto max-w-container-max px-margin-mobile py-section-gap md:px-margin-desktop">
      <header class="mb-stack-lg">
        <h1 id="stack-page-title" class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg">
          {stackPage.data.pageTitle}
        </h1>
        <p id="stack-page-description" class="mt-2 font-body-lg text-body-lg text-on-surface-variant">{stackPage.data.pageDescription}</p>
      </header>

      <div class="grid auto-rows-[250px] grid-cols-1 gap-gutter md:grid-cols-3">
        <article class="glass-panel glass-panel-hover flex flex-col rounded-xl p-stack-md md:col-span-2 md:row-span-2">
          <h2 class="mb-4 font-body-lg text-body-lg font-bold text-on-surface">{t(locale, "stackCoreSkills")}</h2>
          <div id="stack-core-skills-list" class="flex flex-grow flex-col justify-center gap-stack-sm">
            {
              stackPage.data.coreSkills.map((skill) => (
                <div class="mb-2">
                  <div class="mb-1 flex items-center justify-between font-code-sm text-code-sm">
                    <span>{skill.name}</span>
                    <span class="text-secondary">{skill.level}%</span>
                  </div>
                  <div class="h-1 bg-surface-container-high">
                    <div class="h-1 bg-gradient-to-r from-brand-blue to-brand-purple shadow-neon-blue" style={`width: ${skill.level}%`}></div>
                  </div>
                </div>
              ))
            }
          </div>
        </article>

        <article class="glass-panel glass-panel-hover flex flex-col rounded-xl p-stack-md">
          <h2 class="mb-4 font-body-lg text-body-lg font-bold text-on-surface">{t(locale, "stackTools")}</h2>
          <div id="stack-tools-list" class="mt-auto flex flex-wrap gap-2">
            {stackPage.data.tools.map((tool) => <span class="tech-badge px-3 py-1 font-code-sm text-code-sm text-on-surface">{tool}</span>)}
          </div>
        </article>

        <article class="glass-panel glass-panel-hover relative overflow-hidden rounded-xl p-stack-md">
          <div class="pointer-events-none absolute -bottom-10 -right-10 h-32 w-32 rounded-full bg-secondary/10 blur-2xl"></div>
          <h2 class="mb-3 font-body-lg text-body-lg font-bold text-on-surface">{t(locale, "stackFoundations")}</h2>
          <ul id="stack-foundations-list" class="space-y-stack-sm font-code-sm text-code-sm text-on-surface-variant">
            {stackPage.data.foundations.map((item) => <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-tertiary"></span>{item}</li>)}
          </ul>
        </article>
      </div>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
