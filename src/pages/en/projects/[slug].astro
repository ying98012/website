---
import ProjectDetailPage from "@/views/ProjectDetailPage.astro";
import {
  getLocalizedProject,
  getLocalizedProjects,
  getProjectRouteSlug,
} from "@/i18n/utils";

const locale = "en" as const;

export async function getStaticPaths() {
  const projects = await getLocalizedProjects("en");
  return projects.map((project) => ({
    params: { slug: getProjectRouteSlug(project) },
  }));
}

const slug = Astro.params.slug!;
const project = await getLocalizedProject(locale, slug);
if (!project) {
  return Astro.redirect(`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}404`);
}
---

<ProjectDetailPage locale={locale} project={project} />
