---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import { getLocaleFromUrl, localePath, t } from "@/i18n/utils";

const locale = getLocaleFromUrl(Astro.url);
---

<BaseLayout
  title={t(locale, "notFoundTitle")}
  description={t(locale, "notFoundDescription")}
  locale={locale}
  alternatePath="404"
>
  <section class="glass-panel mx-auto max-w-xl rounded-xl p-8 text-center">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-obsidian-neonPurple">404</p>
    <h1 class="mt-3 text-3xl font-bold">{t(locale, "notFoundHeading")}</h1>
    <p class="mt-3 text-obsidian-muted">{t(locale, "notFoundBody")}</p>
    <div class="mt-6 flex justify-center">
      <Button href={localePath(locale, "")}>{t(locale, "notFoundHome")}</Button>
    </div>
  </section>
</BaseLayout>
