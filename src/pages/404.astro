---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 | Weiying Portfolio" description="找不到頁面">
  <section class="glass-panel mx-auto max-w-xl rounded-xl p-8 text-center">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-obsidian-neonPurple">404</p>
    <h1 class="mt-3 text-3xl font-bold">找不到這個頁面</h1>
    <p class="mt-3 text-obsidian-muted">網址可能已變更，或內容尚未發布。</p>
    <div class="mt-6 flex justify-center">
      <Button href={base}>返回首頁</Button>
    </div>
  </section>
</BaseLayout>
