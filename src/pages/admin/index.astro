---
import BaseLayout from "@/layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const dashboardUrl = `${base}admin-dashboard/`;
---

<BaseLayout title="管理後台登入" disableMainWrapper={true}>
  <div class="grid min-h-screen place-items-center px-6">
    <section class="glass-panel w-full max-w-md space-y-5 rounded-xl p-6">
      <h1 class="text-2xl font-bold">管理後台登入</h1>
      <p class="text-sm text-on-surface-variant">
        請輸入帳號密碼進入管理後台。此版本為前端靜態驗證，僅供基本防護用途。
      </p>

      <form id="login-form" class="space-y-4">
        <div class="space-y-2">
          <label class="font-label-caps text-label-caps uppercase tracking-widest text-on-surface-variant" for="username"
            >帳號</label
          >
          <input
            id="username"
            class="cms-input w-full rounded-lg px-4 py-3"
            type="text"
            autocomplete="username"
            required
          />
        </div>
        <div class="space-y-2">
          <label class="font-label-caps text-label-caps uppercase tracking-widest text-on-surface-variant" for="password"
            >密碼</label
          >
          <input
            id="password"
            class="cms-input w-full rounded-lg px-4 py-3"
            type="password"
            autocomplete="current-password"
            required
          />
        </div>
        <p id="error-msg" class="hidden text-sm text-error">帳號或密碼錯誤</p>
        <button class="btn-primary w-full rounded px-5 py-3 font-label-caps text-label-caps uppercase tracking-widest" type="submit">
          登入後台
        </button>
      </form>

      <a class="block text-center text-sm text-secondary underline underline-offset-4" href={base}>回到首頁</a>
    </section>
  </div>

  <script is:inline define:vars={{ dashboardUrl }}>
    // @ts-nocheck
    const ADMIN_USERNAME = "ying_122";
    const ADMIN_PASSWORD = "ian920716";

    const form = document.getElementById("login-form");
    const errorMsg = document.getElementById("error-msg");

    const params = new URLSearchParams(window.location.search);
    const next = params.get("next");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      const username = document.getElementById("username")?.value?.trim();
      const password = document.getElementById("password")?.value;

      if (username === ADMIN_USERNAME && password === ADMIN_PASSWORD) {
        sessionStorage.setItem("admin_auth", "ok");
        window.location.href = next || dashboardUrl;
        return;
      }

      errorMsg?.classList.remove("hidden");
    });
  </script>
</BaseLayout>
