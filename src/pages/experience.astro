---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import TopNav from "@/components/TopNav.astro";
import { getEntry } from "astro:content";

const experiencePage = await getEntry("experience-page", "content");

if (!experiencePage) {
  throw new Error("Missing experience page content: src/content/experience-page/content.md");
}
---

<BaseLayout title="經歷 | Weiying Portfolio" description="專業經歷與工程實作歷程" disableMainWrapper={true}>
  <div class="min-h-screen pt-20">
    <TopNav active="experience" />

    <main class="mx-auto max-w-container-max px-margin-mobile py-section-gap md:px-margin-desktop">
      <header class="mb-stack-lg">
        <h1 class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg">
          {experiencePage.data.pageTitle}
        </h1>
        <p class="mt-3 max-w-2xl font-body-lg text-body-lg text-on-surface-variant">
          {experiencePage.data.pageDescription}
        </p>
      </header>

      <div class="relative grid gap-gutter">
        <div class="pointer-events-none absolute bottom-0 left-3 top-1 w-px bg-outline-variant/40 md:left-1/2 md:-translate-x-1/2"></div>
        {
          experiencePage.data.timeline.map((item, index) => (
            <article
              class={`relative grid gap-4 md:grid-cols-2 ${index % 2 === 0 ? "" : "md:[&>div:first-child]:order-2 md:[&>div:last-child]:order-1"}`}
            >
              <div class="flex items-start md:justify-end">
                <div class="glass-panel glass-panel-hover w-full rounded-xl p-stack-md md:max-w-[90%]">
                  <p class="font-code-sm text-code-sm text-secondary">{item.period}</p>
                  <h2 class="mt-2 text-xl font-bold text-on-surface">{item.role}</h2>
                  <p class="font-body-md text-body-md text-on-surface-variant">{item.company}</p>
                  <ul class="mt-4 space-y-2 font-code-sm text-code-sm text-on-surface-variant">
                    {item.highlights.map((highlight) => <li>&gt; {highlight}</li>)}
                  </ul>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {item.tech.map((tech) => <span class="tech-badge px-2 py-1 font-code-sm text-code-sm text-on-surface">{tech}</span>)}
                  </div>
                </div>
              </div>
              <div class="hidden md:block"></div>
              <span class="absolute left-[9px] top-5 h-3 w-3 rounded-full bg-secondary-container shadow-neon-blue md:left-1/2 md:-translate-x-1/2"></span>
            </article>
          ))
        }
      </div>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
