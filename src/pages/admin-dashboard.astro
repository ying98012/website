---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).map((entry) => ({
  slug: entry.slug,
  frontmatter: entry.data
}));
const base = import.meta.env.BASE_URL;
const siteHome = base;
const editablePages = [
  { label: "首頁", path: "src/pages/index.astro" },
  { label: "經歷頁", path: "src/pages/experience.astro" },
  { label: "技術棧頁", path: "src/pages/stack.astro" },
  { label: "聯絡我頁", path: "src/pages/contact.astro" },
  { label: "管理入口頁", path: "src/pages/admin/index.astro" }
];
const repoEditPrefix = "https://github.com/ying98012/website/edit/main/";
---

<BaseLayout title="Web Admin Dashboard - Add New Project" disableMainWrapper={true}>
  <div class="flex min-h-screen flex-col overflow-x-hidden bg-background text-on-surface antialiased md:flex-row">
    <nav
      class="fixed left-0 top-0 z-50 hidden h-screen w-64 flex-col border-r border-outline-variant/20 bg-surface-container-low py-stack-md font-label-caps text-label-caps text-secondary md:flex"
    >
      <div class="mb-stack-lg px-6">
        <h1 class="mb-1 font-code-sm text-code-sm uppercase tracking-wider text-secondary-fixed-dim">管理主控台</h1>
        <p class="text-[10px] uppercase tracking-widest text-on-surface-variant opacity-70">系統根目錄</p>
      </div>
      <div class="flex flex-grow flex-col gap-2 px-4">
        <a class="flex cursor-pointer items-center gap-3 rounded px-4 py-3 text-on-surface-variant transition-all hover:bg-surface-container-high" href="#">
          <span class="material-symbols-outlined">dashboard</span>
          <span>儀表板</span>
        </a>
        <a
          class="flex cursor-pointer items-center gap-3 rounded border-r-4 border-secondary bg-secondary-container/10 px-4 py-3 text-secondary"
          href="#"
        >
          <span class="material-symbols-outlined">folder_special</span>
          <span>專案管理</span>
        </a>
        <a class="flex cursor-pointer items-center gap-3 rounded px-4 py-3 text-on-surface-variant transition-all hover:bg-surface-container-high" href="#">
          <span class="material-symbols-outlined">monitoring</span>
          <span>數據分析</span>
        </a>
        <a class="flex cursor-pointer items-center gap-3 rounded px-4 py-3 text-on-surface-variant transition-all hover:bg-surface-container-high" href="#">
          <span class="material-symbols-outlined">settings</span>
          <span>設定</span>
        </a>
        <a
          id="sidebar-logout"
          class="flex cursor-pointer items-center gap-3 rounded px-4 py-3 text-on-surface-variant transition-all hover:bg-surface-container-high"
          href={siteHome}
        >
          <span class="material-symbols-outlined">logout</span>
          <span>登出</span>
        </a>
      </div>
      <div class="mt-auto px-4">
        <a class="flex cursor-pointer items-center gap-3 rounded px-4 py-3 text-on-surface-variant transition-all hover:bg-surface-container-high" href={siteHome}>
          <span class="material-symbols-outlined">logout</span>
          <span>返回網站</span>
        </a>
      </div>
    </nav>

    <header class="sticky top-0 z-50 flex h-20 items-center justify-between border-b border-outline-variant/20 bg-surface-container-low px-margin-mobile md:hidden">
      <div>
        <h1 class="font-code-sm text-code-sm uppercase tracking-wider text-secondary-fixed-dim">管理主控台</h1>
        <p class="font-label-caps text-[10px] text-on-surface-variant opacity-70">系統根目錄</p>
      </div>
      <button class="p-2 text-on-surface-variant">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </header>

    <main
      class="mx-auto flex w-full max-w-container-max flex-grow flex-col gap-stack-lg px-margin-mobile py-stack-lg md:ml-64 md:px-margin-desktop md:py-margin-desktop"
    >
      <header class="flex flex-col justify-between gap-4 border-b border-outline-variant/10 pb-stack-md md:flex-row md:items-end">
        <div>
          <h2 class="font-headline-md text-headline-md tracking-tight text-on-surface">新增專案</h2>
          <p class="mt-2 max-w-2xl font-body-md text-body-md text-on-surface-variant">
            發佈新的作品集項目到線上環境。
          </p>
        </div>
        <div
          class="flex items-center gap-3 rounded border border-outline-variant/20 bg-surface-container-low px-4 py-2 font-code-sm text-code-sm text-on-surface-variant"
        >
          <span class="h-2 w-2 animate-pulse rounded-full bg-neon-blue"></span>
          環境：開發版
        </div>
      </header>

      <form id="project-form" class="glass-panel flex w-full flex-col gap-8 rounded-xl p-6 md:p-8">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
          <div class="flex flex-col gap-6 lg:col-span-2">
            <div class="flex flex-col gap-2">
              <label class="flex items-center gap-2 font-label-caps text-label-caps uppercase tracking-widest text-on-surface-variant" for="project-title">
                <span class="material-symbols-outlined text-[16px]">title</span>
                專案標題
              </label>
              <input class="cms-input w-full rounded-lg px-4 py-3 font-body-md text-body-md text-on-surface" id="project-title" placeholder="例如：量子分析儀表板" type="text" />
            </div>

            <div class="flex flex-col gap-2">
              <label class="flex items-center gap-2 font-label-caps text-label-caps uppercase tracking-widest text-on-surface-variant" for="short-desc">
                <span class="material-symbols-outlined text-[16px]">description</span>
                簡短描述
              </label>
              <textarea class="cms-input w-full resize-y rounded-lg px-4 py-3 font-body-md text-body-md text-on-surface" id="short-desc" placeholder="專案用途與核心功能的簡要概述..." rows="4"></textarea>
            </div>

            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              <div class="flex flex-col gap-2">
                <label class="flex items-center gap-2 font-label-caps text-label-caps uppercase tracking-widest text-on-surface-variant" for="demo-link">
                  <span class="material-symbols-outlined text-[16px]">play_circle</span>
                  展示影片連結
                </label>
                <input class="cms-input w-full rounded-lg px-4 py-3 font-body-md text-body-md text-on-surface" id="demo-link" placeholder="https://vimeo.com/..." type="url" />
              </div>
              <div class="flex flex-col gap-2">
                <label class="flex items-center gap-2 font-label-caps text-label-caps uppercase tracking-widest text-on-surface-variant" for="github-link">
                  <span class="material-symbols-outlined text-[16px]">code</span>
                  GitHub README 連結
                </label>
                <input class="cms-input w-full rounded-lg px-4 py-3 font-body-md text-body-md text-on-surface" id="github-link" placeholder="https://github.com/user/repo" type="url" />
              </div>
            </div>

            <div class="mt-2 flex flex-col gap-2">
              <label class="flex items-center gap-2 font-label-caps text-label-caps uppercase tracking-widest text-on-surface-variant">
                <span class="material-symbols-outlined text-[16px]">terminal</span>
                使用技術
              </label>
              <div id="tech-stack-input" class="cms-input flex min-h-[56px] flex-wrap items-center gap-2 rounded-lg p-3">
                <input
                  id="tech-input"
                  class="min-w-[120px] flex-grow border-none bg-transparent font-code-sm text-code-sm text-on-surface placeholder-on-surface-variant/50 outline-none focus:ring-0"
                  placeholder="新增技術 + Enter"
                  type="text"
                />
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-2 lg:border-l lg:border-outline-variant/10 lg:pl-8">
            <label class="mb-2 flex items-center gap-2 font-label-caps text-label-caps uppercase tracking-widest text-on-surface-variant">
              <span class="material-symbols-outlined text-[16px]">image</span>
              封面圖片
            </label>
            <div
              class="upload-zone group relative flex h-full min-h-[250px] cursor-pointer flex-col items-center justify-center overflow-hidden rounded-lg bg-surface-container-low p-8"
            >
              <span class="material-symbols-outlined z-10 mb-4 text-[48px] text-on-surface-variant transition-colors group-hover:text-neon-blue">
                cloud_upload
              </span>
              <p class="z-10 text-center font-body-md text-body-md text-on-surface">拖放圖片至此</p>
              <p class="z-10 mt-2 text-center font-code-sm text-[12px] text-on-surface-variant">
                JPEG, PNG, WEBP (Max 5MB)<br />建議比例 16:9
              </p>
            </div>
          </div>
        </div>

        <div class="mt-4 flex flex-col items-center justify-end gap-4 border-t border-outline-variant/10 pt-6 sm:flex-row">
          <button
            id="generate-draft"
            class="btn-secondary flex w-full items-center justify-center gap-2 rounded px-6 py-3 font-label-caps text-label-caps uppercase tracking-widest sm:w-auto"
            type="button"
          >
            <span class="material-symbols-outlined text-[18px]">draft</span>
            產生 Markdown 草稿
          </button>
          <button
            class="btn-primary flex w-full items-center justify-center gap-2 rounded px-8 py-3 font-label-caps text-label-caps uppercase tracking-widest sm:w-auto"
            type="button"
            id="open-cms"
          >
            <span class="material-symbols-outlined text-[18px]">rocket_launch</span>
            開啟 Pages CMS 發佈
          </button>
        </div>

        <div class="flex flex-col gap-3">
          <label class="font-label-caps text-label-caps uppercase tracking-widest text-on-surface-variant">
            產生的 Markdown（可直接貼到 CMS 或 GitHub）
          </label>
          <textarea
            id="markdown-output"
            class="cms-input min-h-[220px] w-full rounded-lg px-4 py-3 font-code-sm text-code-sm text-on-surface"
            placeholder="點擊「產生 Markdown 草稿」後會出現在這裡"
          ></textarea>
          <div class="flex flex-wrap gap-3">
            <button id="copy-markdown" class="btn-secondary rounded px-5 py-2 font-label-caps text-label-caps uppercase tracking-widest" type="button">
              複製 Markdown
            </button>
            <a
              class="btn-secondary rounded px-5 py-2 font-label-caps text-label-caps uppercase tracking-widest"
              href="https://github.com/ying98012/website/tree/main/src/content/projects"
              target="_blank"
              rel="noreferrer"
            >
              在 GitHub 查看內容資料夾
            </a>
          </div>
        </div>
      </form>

      <section class="glass-panel rounded-xl p-6 md:p-8">
        <header class="mb-4">
          <h3 class="font-headline-md text-headline-md text-on-surface">頁面管理</h3>
          <p class="mt-2 font-body-md text-body-md text-on-surface-variant">可直接編輯目前網站所有主要頁面程式碼。</p>
        </header>
        <div class="grid gap-3 md:grid-cols-2">
          {
            editablePages.map((item) => (
              <a
                href={`${repoEditPrefix}${item.path}`}
                class="btn-secondary rounded px-4 py-3 font-label-caps text-label-caps"
                target="_blank"
                rel="noreferrer"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </section>

      <section class="glass-panel rounded-xl p-6 md:p-8">
        <header class="mb-4 flex items-center justify-between">
          <h3 class="font-headline-md text-headline-md text-on-surface">現有專案管理</h3>
          <a
            href={siteHome}
            class="font-code-sm text-code-sm text-secondary transition-colors hover:text-on-surface"
          >
            回前台預覽
          </a>
        </header>
        <div class="grid gap-4">
          {
            projects.map((project) => (
              <article class="rounded-lg border border-outline-variant/20 bg-surface-container-low p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <h4 class="text-lg font-bold text-on-surface">{project.frontmatter.title}</h4>
                    <p class="font-code-sm text-code-sm text-on-surface-variant">{project.slug}</p>
                  </div>
                  <div class="flex gap-2">
                    <a
                      href={`/projects/${project.slug}/`}
                      class="btn-secondary rounded px-4 py-2 font-label-caps text-label-caps"
                      target="_blank"
                      rel="noreferrer"
                    >
                      前台預覽
                    </a>
                    <a
                      href={`https://github.com/ying98012/website/edit/main/src/content/projects/${project.slug}.md`}
                      class="btn-secondary rounded px-4 py-2 font-label-caps text-label-caps"
                      target="_blank"
                      rel="noreferrer"
                    >
                      GitHub 編輯
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </main>
  </div>
  <script is:inline>
    // @ts-nocheck
    const form = document.getElementById("project-form");
    const markdownOutput = document.getElementById("markdown-output");
    const techInput = document.getElementById("tech-input");
    const techContainer = document.getElementById("tech-stack-input");
    const generateButton = document.getElementById("generate-draft");
    const copyButton = document.getElementById("copy-markdown");
    const openCmsButton = document.getElementById("open-cms");
    const sidebarLogout = document.getElementById("sidebar-logout");

    const addTag = (label) => {
      const trimmed = label.trim();
      if (!trimmed) return;
      const chip = document.createElement("span");
      chip.className = "tech-badge flex items-center gap-2 px-3 py-1 font-code-sm text-[12px]";
      chip.setAttribute("data-tag", "true");
      chip.innerHTML =
        `${trimmed}<button class="text-on-surface-variant transition-colors hover:text-error" type="button" data-remove-tag><span class="material-symbols-outlined text-[14px]">close</span></button>`;
      techContainer.insertBefore(chip, techInput);
      techInput.value = "";
    };

    const collectTags = () =>
      [...techContainer.querySelectorAll("[data-tag]")].map((node) =>
        node.textContent.replace("close", "").trim()
      );

    const slugify = (input) =>
      input
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\\s-]/g, "")
        .replace(/\\s+/g, "-")
        .replace(/-+/g, "-");

    const generateMarkdown = () => {
      const title = document.getElementById("project-title").value.trim();
      const summary = document.getElementById("short-desc").value.trim();
      const videoUrl = document.getElementById("demo-link").value.trim();
      const githubUrl = document.getElementById("github-link").value.trim();
      const slug = slugify(title || "new-project");
      const today = new Date().toISOString().slice(0, 10);
      const techStack = collectTags();

      const markdown = `---
title: ${title || "New Project"}
slug: ${slug}
summary: ${summary || "請補上專案摘要"}
techStack:
${techStack.length ? techStack.map((tech) => `  - ${tech}`).join("\\n") : "  - Astro"}
coverImage: /uploads/${slug}.svg
${videoUrl ? `videoUrl: ${videoUrl}` : "videoUrl: https://www.youtube.com/watch?v=dQw4w9WgXcQ"}
${githubUrl ? `githubUrl: ${githubUrl}` : "githubUrl: https://github.com/ying98012/website"}
featured: false
publishedAt: ${today}
---

請在這裡撰寫專案內容，包含：

- 問題背景
- 解決方案
- 你負責的核心技術與成果
`;
      markdownOutput.value = markdown;
      return { markdown, slug };
    };

    techInput?.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        addTag(techInput.value);
      }
    });

    techContainer?.addEventListener("click", (event) => {
      const target = event.target;
      const button = target.closest("[data-remove-tag]");
      if (button) {
        button.closest("[data-tag]")?.remove();
      }
    });

    generateButton?.addEventListener("click", () => {
      generateMarkdown();
    });

    copyButton?.addEventListener("click", async () => {
      if (!markdownOutput.value) generateMarkdown();
      await navigator.clipboard.writeText(markdownOutput.value);
      copyButton.textContent = "已複製";
      setTimeout(() => {
        copyButton.textContent = "複製 Markdown";
      }, 1200);
    });

    openCmsButton?.addEventListener("click", () => {
      generateMarkdown();
      window.open("https://pagescms.org", "_blank", "noopener,noreferrer");
    });

    sidebarLogout?.addEventListener("click", () => {
      sessionStorage.removeItem("admin_auth");
    });

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
    });
  </script>
</BaseLayout>
