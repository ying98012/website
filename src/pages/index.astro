---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import TopNav from "@/components/TopNav.astro";
import { getCollection, getEntry } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
const homePage = await getEntry("home-page", "content");
const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;
const toProjectPath = (slug: string) => `${baseWithSlash}projects/${slug}/`;
const toAssetPath = (path: string) =>
  path.startsWith("/") ? `${baseWithSlash}${path.slice(1)}` : path;

if (!homePage) {
  throw new Error("Missing home page content: src/content/home-page/content.md");
}
---

<BaseLayout
  title="Weiying Portfolio"
  description="個人網站作品集首頁"
  disableMainWrapper={true}
>
  <div class="flex min-h-screen flex-col pt-20">
    <TopNav active="projects" />

    <main class="flex-grow">
      <section
        class="mx-auto flex max-w-container-max flex-col items-center px-margin-mobile py-section-gap text-center md:px-margin-desktop"
      >
        <h1 class="mb-stack-md max-w-4xl font-display-lg-mobile text-display-lg-mobile leading-tight tracking-tight md:font-display-lg md:text-display-lg">
          {homePage.data.heroTitle}
        </h1>
        <p class="mb-stack-lg max-w-3xl font-body-lg text-body-lg leading-relaxed text-on-surface-variant">
          {homePage.data.heroDescription}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-gutter">
          <a
            class="btn-primary flex items-center gap-2 rounded px-6 py-3 font-label-caps text-label-caps"
            href={homePage.data.primaryButtonUrl}
            target="_blank"
            rel="noreferrer"
          >
            <span class="material-symbols-outlined">code</span>
            {homePage.data.primaryButtonLabel}
          </a>
          <a
            class="btn-secondary flex items-center gap-2 rounded px-6 py-3 font-label-caps text-label-caps"
            href={homePage.data.secondaryButtonUrl}
            target="_blank"
            rel="noreferrer"
          >
            <span class="material-symbols-outlined">work</span>
            {homePage.data.secondaryButtonLabel}
          </a>
        </div>
      </section>

      <section id="projects" class="mx-auto max-w-container-max px-margin-mobile pb-section-gap md:px-margin-desktop">
        <header class="mb-stack-lg border-b border-outline-variant/10 pb-stack-sm">
          <div>
            <h2 class="font-headline-md text-headline-md text-on-surface">{homePage.data.projectsTitle}</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">{homePage.data.projectsDescription}</p>
          </div>
        </header>
        <div class="grid grid-cols-1 gap-gutter md:grid-cols-2 lg:grid-cols-3">
          {
            projects.map((project) => (
              <article class="glass-panel glass-panel-hover group flex h-full w-full flex-col overflow-hidden transition-all duration-300">
                <div class="relative aspect-video w-full overflow-hidden bg-surface-container-highest">
                  <img
                    alt={project.data.title}
                    class="h-full w-full object-cover opacity-70 transition-opacity duration-500 group-hover:opacity-100"
                    src={toAssetPath(project.data.coverImage)}
                  />
                </div>
                <div class="flex flex-grow flex-col justify-between p-stack-md">
                  <div>
                    <h3 class="mb-stack-sm font-headline-md text-headline-md text-on-surface transition-colors duration-300 group-hover:text-brand-blue">
                      {project.data.title}
                    </h3>
                    <div class="mb-stack-md flex flex-wrap gap-2">
                      {project.data.techStack.map((tech) => (
                        <span class="tech-badge px-2 py-1 font-code-sm text-code-sm text-on-surface-variant">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>
                  <a
                    class="flex w-fit items-center gap-1 font-code-sm text-code-sm text-brand-purple transition-colors duration-300 hover:text-brand-blue"
                    href={toProjectPath(project.slug)}
                  >
                    <span class="material-symbols-outlined text-sm">description</span>
                    View README.md 文檔
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

    </main>

    <SiteFooter />
  </div>
</BaseLayout>
