---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug }
  }));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect("/");
}

const allProjects = await getCollection("projects");
const project = allProjects.find((entry) => entry.slug === slug);
if (!project) {
  return Astro.redirect("/404");
}

const { Content } = await project.render();
const publishedAt = project.data.publishedAt.toLocaleDateString("zh-TW", {
  year: "numeric",
  month: "long"
});
---

<BaseLayout
  title={`${project.data.title} | Weiying Portfolio`}
  description={project.data.summary}
  disableMainWrapper={true}
>
  <div class="flex min-h-screen flex-col">
    <header class="fixed top-0 z-50 w-full border-b border-outline-variant/10 bg-background/80 backdrop-blur-md">
      <div
        class="mx-auto flex h-20 max-w-container-max items-center justify-between px-margin-mobile md:px-margin-desktop"
      >
        <div class="font-display-lg text-display-lg-mobile tracking-tighter text-on-surface">
          DEV_CORE
        </div>
        <div class="font-body-md text-body-md">
          <a
            class="flex items-center gap-2 text-secondary transition-transform duration-300 hover:text-on-surface-variant"
            href="/"
          >
            <span class="material-symbols-outlined">arrow_back</span>
            返回專案列表
          </a>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-container-max flex-grow px-margin-mobile pb-section-gap pt-32 md:px-margin-desktop">
      <div class="grid grid-cols-1 gap-gutter lg:grid-cols-12">
        <div class="flex flex-col gap-stack-md lg:col-span-8">
          <div class="glass-panel group relative aspect-video w-full overflow-hidden rounded-lg border border-outline-variant">
            <img
              alt={project.data.title}
              class="h-full w-full object-cover opacity-80 transition-opacity duration-300 group-hover:opacity-100"
              src={project.data.coverImage}
            />
            <div class="absolute inset-0 flex items-center justify-center">
              <a
                href={project.data.videoUrl || "#"}
                target="_blank"
                rel="noreferrer"
                class="flex h-20 w-20 items-center justify-center rounded-full border border-outline/50 bg-surface-container-high/80 shadow-[0_0_20px_rgba(157,80,187,0.3)] backdrop-blur-md transition-all duration-300 group-hover:scale-110 group-hover:border-tertiary"
              >
                <span class="material-symbols-outlined pl-1 text-4xl text-tertiary">play_arrow</span>
              </a>
            </div>
          </div>
          <section class="glass-panel prose prose-invert max-w-none rounded-lg p-stack-md">
            <Content />
          </section>
        </div>

        <aside class="flex flex-col gap-stack-lg lg:col-span-4">
          <div class="flex flex-col gap-stack-sm">
            <h1 class="font-headline-md text-headline-md tracking-tight text-on-surface">
              {project.data.title}
            </h1>
            <div class="flex items-center gap-2 font-code-sm text-code-sm text-on-surface-variant">
              <span class="material-symbols-outlined text-sm">calendar_month</span>
              {publishedAt}
            </div>
          </div>

          <div class="glass-panel rounded-lg p-stack-md">
            <h3 class="mb-4 font-label-caps text-label-caps text-tertiary">核心功能</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">{project.data.summary}</p>
          </div>

          <div class="flex flex-col gap-stack-sm">
            <h3 class="font-label-caps text-label-caps text-tertiary">技術棧</h3>
            <div class="flex flex-wrap gap-2">
              {project.data.techStack.map((tech) => (
                <span class="tech-badge px-3 py-1 font-code-sm text-code-sm text-on-surface">{tech}</span>
              ))}
            </div>
          </div>
        </aside>
      </div>

      <div class="mt-section-gap flex justify-center">
        <a
          class="group relative inline-flex w-full max-w-3xl items-center justify-center overflow-hidden rounded-lg border border-outline-variant bg-surface-container-high px-8 py-6 transition-all duration-300 hover:border-tertiary"
          href={project.data.githubUrl}
          target="_blank"
          rel="noreferrer"
        >
          <div class="absolute inset-0 h-full w-full -translate-x-full bg-gradient-to-r from-transparent via-tertiary/10 to-transparent transition-transform duration-1000 ease-in-out group-hover:translate-x-full">
          </div>
          <div class="relative flex items-center gap-4">
            <span class="text-2xl">👉</span>
            <span class="font-body-lg text-body-lg text-on-surface transition-colors duration-300 group-hover:text-tertiary">
              點此查看該作品的完整 README.md 說明文檔
            </span>
            <span class="material-symbols-outlined text-on-surface-variant transition-all duration-300 group-hover:translate-x-1 group-hover:text-tertiary">
              arrow_forward
            </span>
          </div>
        </a>
      </div>
    </main>

    <footer class="mt-auto w-full border-t border-outline-variant/10 bg-surface-container-lowest py-stack-lg">
      <div
        class="mx-auto flex max-w-container-max flex-col items-center justify-between gap-base px-margin-mobile md:flex-row"
      >
        <div class="font-label-caps text-label-caps text-primary">© 2024 DEV_CORE // 為效能而生</div>
        <nav class="flex gap-stack-md font-code-sm text-code-sm">
          <a class="text-on-surface-variant underline underline-offset-4 transition-opacity duration-300 hover:text-secondary" href="#"
            >Email</a
          >
          <a class="text-on-surface-variant underline underline-offset-4 transition-opacity duration-300 hover:text-secondary" href="#"
            >LinkedIn</a
          >
          <a
            class="text-on-surface-variant underline underline-offset-4 transition-opacity duration-300 hover:text-secondary"
            href="https://github.com/ying98012"
            target="_blank"
            rel="noreferrer"
            >GitHub</a
          >
          <a
            class="text-on-surface-variant underline underline-offset-4 transition-opacity duration-300 hover:text-secondary"
            href="https://github.com/ying98012/website"
            target="_blank"
            rel="noreferrer"
            >Source</a
          >
        </nav>
      </div>
    </footer>
  </div>
</BaseLayout>
