---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  mainClass?: string;
  disableMainWrapper?: boolean;
}

const {
  title,
  description = "以 Astro 與 Pages CMS 建立的工程師作品集網站。",
  mainClass = "mx-auto min-h-screen max-w-container px-5 py-10 md:px-16",
  disableMainWrapper = false
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    {
      disableMainWrapper ? (
        <slot />
      ) : (
        <main class={mainClass}>
          <slot />
        </main>
      )
    }
  </body>
</html>
