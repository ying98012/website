---
import { defaultLocale, t, type Locale } from "@/i18n/utils";

interface Props {
  url?: string;
  locale?: Locale;
}

const { url, locale = defaultLocale } = Astro.props;

const toEmbedUrl = (rawUrl?: string): string | undefined => {
  if (!rawUrl) return undefined;

  if (rawUrl.includes("youtube.com/watch?v=")) {
    const id = new URL(rawUrl).searchParams.get("v");
    return id ? `https://www.youtube.com/embed/${id}` : undefined;
  }
  if (rawUrl.includes("youtu.be/")) {
    const id = rawUrl.split("/").pop();
    return id ? `https://www.youtube.com/embed/${id}` : undefined;
  }
  if (rawUrl.includes("vimeo.com/")) {
    const id = rawUrl.split("/").pop();
    return id ? `https://player.vimeo.com/video/${id}` : undefined;
  }
  return undefined;
};

const embedUrl = toEmbedUrl(url);
---

{
  embedUrl ? (
    <div class="glass-panel overflow-hidden rounded-lg">
      <iframe
        class="aspect-video w-full"
        src={embedUrl}
        title="Project Demo Video"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>
  ) : (
    <div class="glass-panel rounded-lg p-6 text-sm text-obsidian-muted">
      {t(locale, "projectNoEmbedVideo")}
    </div>
  )
}
