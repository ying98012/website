---
type NavKey = "projects" | "experience" | "stack" | "contact";

interface NavItem {
  key: NavKey;
  label: string;
  href: string;
}

interface Props {
  active?: NavKey;
}

const { active = "projects" } = Astro.props;
const base = import.meta.env.BASE_URL;
const adminUrl = `${base}admin/`;

const navItems: NavItem[] = [
  { key: "projects", label: "專案內容", href: `${base}#projects` },
  { key: "experience", label: "經歷", href: `${base}experience/` },
  { key: "stack", label: "技術棧", href: `${base}stack/` },
  { key: "contact", label: "聯絡我", href: `${base}contact/` }
];
---

<nav class="fixed top-0 z-50 w-full border-b border-outline-variant/10 bg-background/80 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-container-max items-center justify-between px-margin-mobile md:px-margin-desktop">
    <a class="font-display-lg text-display-lg-mobile tracking-tighter text-on-surface" href={base}>個人網站</a>
    <div class="hidden space-x-8 md:flex">
      {
        navItems.map((item) => (
          <a
            class={`font-body-md text-body-md transition-colors hover:text-secondary ${active === item.key ? "border-b-2 border-secondary pb-1 text-secondary" : "text-on-surface-variant"}`}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </div>
    <div class="flex items-center">
      <a class="font-body-md text-body-md text-secondary transition-transform active:scale-95" href={adminUrl}>管理後台</a>
    </div>
  </div>
</nav>
