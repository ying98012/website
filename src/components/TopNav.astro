---
type NavKey = "projects" | "experience" | "stack" | "contact";

interface NavItem {
  key: NavKey;
  label: string;
  href: string;
}

interface Props {
  active?: NavKey;
}

const { active = "projects" } = Astro.props;
const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;
const adminUrl = `${baseWithSlash}admin/`;

const navItems: NavItem[] = [
  { key: "projects", label: "專案內容", href: `${baseWithSlash}#projects` },
  { key: "experience", label: "經歷", href: `${baseWithSlash}experience/` },
  { key: "stack", label: "技術棧", href: `${baseWithSlash}stack/` },
  { key: "contact", label: "聯絡我", href: `${baseWithSlash}contact/` }
];
---

<nav class="fixed top-0 z-50 w-full border-b border-outline-variant/10 bg-background/80 backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-container-max items-center justify-between px-margin-mobile md:px-margin-desktop">
    <a class="font-display-lg text-display-lg-mobile tracking-tighter text-on-surface" href={baseWithSlash}>個人網站</a>
    <ul class="hidden items-center gap-8 md:flex">
      {
        navItems.map((item) => (
          <li>
            <a
              class={`pb-1 font-body-md text-body-md transition-colors duration-300 hover:text-secondary ${active === item.key ? "border-b-2 border-secondary text-secondary" : "text-on-surface-variant"}`}
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center">
      <a class="font-body-md text-body-md text-secondary transition-transform duration-300 hover:text-secondary active:scale-95" href={adminUrl}>
        管理後台
      </a>
    </div>
  </div>
</nav>
