---
import {
  alternateLocale,
  localePath,
  t,
  type Locale,
} from "@/i18n/utils";

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = "" } = Astro.props;
const otherLocale = alternateLocale(locale);
const otherHref = localePath(otherLocale, path);
---

<nav class="flex items-center gap-2 font-body-md text-body-md" aria-label={t(locale, "langSwitcherLabel")}>
  {
    locale === "zh-Hant" ? (
      <span class="text-secondary" aria-current="true">{t(locale, "langZh")}</span>
    ) : (
      <a class="text-on-surface-variant transition-colors duration-300 hover:text-secondary" href={localePath("zh-Hant", path)}>
        {t(locale, "langZh")}
      </a>
    )
  }
  <span class="text-outline-variant" aria-hidden="true">/</span>
  {
    locale === "en" ? (
      <span class="text-secondary" aria-current="true">{t(locale, "langEn")}</span>
    ) : (
      <a class="text-on-surface-variant transition-colors duration-300 hover:text-secondary" href={otherHref}>
        {t(locale, "langEn")}
      </a>
    )
  }
</nav>
