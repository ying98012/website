---
import TechBadge from "@/components/TechBadge.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;
const projectUrl = `${baseWithSlash}projects/${project.slug}/`;
const coverImageUrl = project.data.coverImage.startsWith("/")
  ? `${baseWithSlash}${project.data.coverImage.slice(1)}`
  : project.data.coverImage;
---

<a
  href={projectUrl}
  class="group glass-panel block overflow-hidden rounded-xl transition hover:shadow-neon-blue"
>
  <img
    src={coverImageUrl}
    alt={`${project.data.title} cover`}
    class="aspect-video w-full object-cover transition duration-300 group-hover:scale-[1.02]"
    loading="lazy"
  />
  <div class="space-y-3 p-4">
    <div class="flex items-center justify-between gap-3">
      <h3 class="text-xl font-bold">{project.data.title}</h3>
      {project.data.featured && (
        <span class="rounded-full bg-vibrant-accent px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-obsidian-neonBlue">
          Featured
        </span>
      )}
    </div>
    <p class="text-sm text-obsidian-muted">{project.data.summary}</p>
    <div class="flex flex-wrap gap-2">
      {project.data.techStack.map((tech) => (
        <TechBadge label={tech} />
      ))}
    </div>
  </div>
</a>
