---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;
const projectUrl = `${baseWithSlash}projects/${project.slug}/`;
const coverImageUrl = project.data.coverImage.startsWith("/")
  ? `${baseWithSlash}${project.data.coverImage.slice(1)}`
  : project.data.coverImage;
const coverAspectClass = {
  square: "aspect-square",
  portrait: "aspect-[3/4]",
  landscape: "aspect-video",
}[project.data.coverAspect];
---

<article class="glass-panel glass-panel-hover group flex h-full w-full flex-col overflow-hidden transition-all duration-300">
  <div
    class:list={[
      "relative w-full overflow-hidden bg-surface-container-highest",
      coverAspectClass,
    ]}
  >
    <img
      alt={project.data.title}
      class="h-full w-full object-cover opacity-70 transition-opacity duration-500 group-hover:opacity-100"
      src={coverImageUrl}
      loading="lazy"
    />
    {
      project.data.featured && (
        <span class="absolute right-3 top-3 rounded bg-surface-container-high/90 px-3 py-1 font-code-sm text-code-sm uppercase tracking-[0.18em] text-brand-blue backdrop-blur-sm">
          Featured
        </span>
      )
    }
  </div>
  <div class="flex flex-grow flex-col justify-between p-stack-md">
    <div>
      <h3 class="mb-stack-sm font-headline-md text-headline-md text-on-surface transition-colors duration-300 group-hover:text-brand-blue">
        {project.data.title}
      </h3>
      <div class="mb-stack-md flex flex-wrap gap-2">
        {
          project.data.techStack.map((tech) => (
            <span class="tech-badge px-2 py-1 font-code-sm text-code-sm text-on-surface-variant">
              {tech}
            </span>
          ))
        }
      </div>
    </div>
    <a
      class="flex w-fit items-center gap-1 font-code-sm text-code-sm text-brand-purple transition-colors duration-300 hover:text-brand-blue"
      href={projectUrl}
    >
      <span class="material-symbols-outlined text-sm">description</span>
      View README.md 文檔
    </a>
  </div>
</article>
