# Optional: set if deploying to non-default path
PUBLIC_SITE_URL=https://ying98012.github.io/website

# === Admin GitHub OAuth 2.0 ===
# 1. 於 GitHub 建立 OAuth App 後填入下列兩個值（前端可見）
PUBLIC_OAUTH_CLIENT_ID=
# 2. 已部署的 Cloudflare Worker URL（前端會 POST /exchange、/revoke）
PUBLIC_OAUTH_PROXY_URL=
# 3. OAuth 權限範圍（預設 public_repo + read:user，可改為 repo 用於私有 repo）
PUBLIC_OAUTH_SCOPE=public_repo read:user
# 4. 允許登入管理後台的 GitHub 帳號（逗號分隔，小寫）
PUBLIC_OAUTH_ALLOWED_LOGINS=ying98012
